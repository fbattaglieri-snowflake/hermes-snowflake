SNOWFLAKE_ACCOUNT=org-account
SNOWFLAKE_USER=service_user
SNOWFLAKE_PRIVATE_KEY_PATH=/secure/path/rsa_key.p8

# Upstream Multi-API Proxy (deploy Option A, Option B, or both):
# Option A — Snowflake Cortex REST API Proxy (snowflake-proxy-cortexrestapi)
STANDARD_PROXY_ORIGIN=http://llm-proxy-standard.core.svc.spcs.internal:8080
# Option B — Snowflake Cortex AI Gateway Proxy (snowflake-proxy-cortex-aigateway)
AIGATEWAY_PROXY_ORIGIN=http://llm-proxy-aigateway.core.svc.spcs.internal:8080

# Active default provider & model:
#   Option A: snowflake-standard-responses | snowflake-standard-chat | snowflake-standard-messages
#   Option B: snowflake-aigateway-messages | snowflake-aigateway-responses | snowflake-aigateway-chat
#   Option C: snowflake-cortex-proxy (embedded loopback fallback on 127.0.0.1:8080)
HERMES_PROVIDER=snowflake-aigateway-messages
HERMES_MODEL=claude-opus-5-5

CORTEX_PAT=stored-outside-this-repository
TS_AUTHKEY=stored-outside-this-repository
